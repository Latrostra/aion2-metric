{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aion2-metric",
  "version": "0.1.0",
  "identifier": "dev.latrostra.aion2metric",
  "build": {
    "frontendDist": "../meter-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "aion2-metric",
        "width": 440,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": true,
        "minWidth": 240,
        "minHeight": 140
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"]
  }
}
